# URL de la API, nunca la conexión PostgreSQL ni credenciales privadas.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# EAS activa esta opción en el APK de pruebas para mostrar solo la demo.
EXPO_PUBLIC_DEMO_ONLY=false
# El login utiliza google-services.json (ignorado por Git).
# En EAS, proporcionar ese archivo mediante la variable de tipo File GOOGLE_SERVICES_JSON.
# Las búsquedas de Google Maps siguen sin necesitar una clave de API.
