{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEMO_ONLY": "true",
        "EXPO_PUBLIC_REGISTRATION_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
