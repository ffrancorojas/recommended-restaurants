{
  "name": "restaurantes-recomendados",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run build --workspace=@restaurantes/contracts",
    "dev": "concurrently --raw --kill-others \"npm run dev --workspace=@restaurantes/api -- --preserveWatchOutput\" \"npm start\"",
    "postinstall": "npm run build --workspace=@restaurantes/contracts",
    "start": "npm run start --workspace=@restaurantes/mobile --",
    "android": "npm run android --workspace=@restaurantes/mobile",
    "ios": "npm run ios --workspace=@restaurantes/mobile",
    "web": "npm run web --workspace=@restaurantes/mobile",
    "api:dev": "npm run dev --workspace=@restaurantes/api",
    "api:start": "npm run start --workspace=@restaurantes/api",
    "build": "npm run build --workspace=@restaurantes/contracts && npm run build --workspace=@restaurantes/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@restaurantes/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:migrate": "npm run db:migrate --workspace=@restaurantes/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
